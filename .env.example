# Segredo compartilhado entre backend e mcp-server.
# O mcp-server valida o JWT emitido pelo backend com esta mesma chave.
JWT_SECRET=troque-este-segredo-em-producao

# Portas
BACKEND_PORT=3000
MCP_PORT=3001

# URL do MCP server (transporte Streamable HTTP)
MCP_URL=http://localhost:3001/mcp

# Ollama (endpoint compativel com OpenAI)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# TTL da intencao em segundos (baixar para 10 ao gravar o teste de expiracao)
INTENCAO_TTL_SEGUNDOS=300

# Maximo de iteracoes do loop do agente
MAX_ITERACOES_AGENTE=5
